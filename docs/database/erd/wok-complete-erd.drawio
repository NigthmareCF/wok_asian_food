        <mxCell id="title" value="06 - Inventory&lt;br&gt;WOK ASIAN FOOD · Entidades, atributos y relaciones · PostgreSQL 18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">

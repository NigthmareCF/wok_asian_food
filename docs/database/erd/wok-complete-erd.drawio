  <diagram id="page-15" name="15 - Legacy Mapping">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" page="0" pageScale="1" background="#0d1117" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="15 - Legacy Mapping&lt;br&gt;WOK ASIAN FOOD · Entidades, atributos y relaciones · PostgreSQL 18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="20" width="1500" height="65" />
        </mxCell>
        <mxCell id="legend" value="PK: clave primaria · FK: clave foránea · ?: admite NULL&lt;br&gt;Conexiones: atributo FK → atributo PK; cardinalidad junto a la relación.&lt;br&gt;Las pestañas 01–14 amplían cada dominio. En Overview aparecen las 109 entidades completas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="100" width="1500" height="85" />
        </mxCell>
        <mxCell id="legacy-0" value="&lt;b&gt;INVENTARIO_PRODUCTO&lt;/b&gt;&lt;br&gt;→ inventory_balances / stock_thresholds / inventory_movements&lt;br&gt;&lt;br&gt;Sustituir stock agregado por saldos y libro.&lt;br&gt;Permite ubicaciones, lotes y reconstrucción." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="220" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-1" value="&lt;b&gt;PRODUCTO&lt;/b&gt;&lt;br&gt;→ items / presentations / supplier_items / supplier_item_prices&lt;br&gt;&lt;br&gt;Separar catálogo, presentación y proveedor.&lt;br&gt;El item admite múltiples ofertas y precios históricos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="220" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-2" value="&lt;b&gt;ASIG_PRODUCT_PRODU&lt;/b&gt;&lt;br&gt;→ recipes / recipe_versions / recipe_components&lt;br&gt;&lt;br&gt;Convertir asociación en BOM cuantificada.&lt;br&gt;Una receta puede consumir cualquier item." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="220" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-3" value="&lt;b&gt;INVENT_PRODUCC&lt;/b&gt;&lt;br&gt;→ inventory_lots / inventory_balances / stock_thresholds&lt;br&gt;&lt;br&gt;Unificar inventarios.&lt;br&gt;Las preparaciones también son items inventariables." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="220" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-4" value="&lt;b&gt;PRODUCCION&lt;/b&gt;&lt;br&gt;→ items / recipes / production_orders / production_batches / production_outputs&lt;br&gt;&lt;br&gt;Separar definición y ejecución.&lt;br&gt;El preliminar mezcla nombre, cantidad y elaboración." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="410" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-5" value="&lt;b&gt;MEDIDAS&lt;/b&gt;&lt;br&gt;→ units&lt;br&gt;&lt;br&gt;Normalizar dimensiones y conversiones.&lt;br&gt;Cantidades decimales, sin conversión masa-volumen implícita." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="410" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-6" value="&lt;b&gt;PRESENTACION&lt;/b&gt;&lt;br&gt;→ presentations&lt;br&gt;&lt;br&gt;Agregar item y factor a unidad base.&lt;br&gt;Una bolsa no equivale a una cantidad universal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="410" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-7" value="&lt;b&gt;PROVEEDOR&lt;/b&gt;&lt;br&gt;→ suppliers / supplier_items&lt;br&gt;&lt;br&gt;Extraer relación muchos a muchos.&lt;br&gt;Teléfono es texto y no entero." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="410" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-8" value="&lt;b&gt;INGREDIENTES&lt;/b&gt;&lt;br&gt;→ items / recipe_components&lt;br&gt;&lt;br&gt;Eliminar doble FK producto/producción como identidad.&lt;br&gt;Un componente tiene una referencia no ambigua a item." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="600" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-9" value="&lt;b&gt;INGR_PLAT&lt;/b&gt;&lt;br&gt;→ recipes / recipe_versions / recipe_components / menu_items&lt;br&gt;&lt;br&gt;Relacionar platillo con receta versionada.&lt;br&gt;Congela composición y admite subrecetas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="600" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-10" value="&lt;b&gt;ASIG_AREA_CATE&lt;/b&gt;&lt;br&gt;→ menu_items.preparation_area_id / menu_categories&lt;br&gt;&lt;br&gt;Asignar área al platillo.&lt;br&gt;Una categoría comercial no determina la estación operativa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="600" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-11" value="&lt;b&gt;CATEGORIA&lt;/b&gt;&lt;br&gt;→ menu_categories / item_types&lt;br&gt;&lt;br&gt;Separar categoría comercial y clasificación física.&lt;br&gt;Son dimensiones independientes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="600" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-12" value="&lt;b&gt;AREA&lt;/b&gt;&lt;br&gt;→ preparation_areas&lt;br&gt;&lt;br&gt;Conservar área y extender ruteo.&lt;br&gt;Permite dividir comandas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="790" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-13" value="&lt;b&gt;PLATILLO&lt;/b&gt;&lt;br&gt;→ menu_items / items&lt;br&gt;&lt;br&gt;Separar oferta comercial e item físico.&lt;br&gt;Precios decimales, visibilidad, receta e imagen." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="790" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-14" value="&lt;b&gt;ASIG_MOD_PLAT&lt;/b&gt;&lt;br&gt;→ menu_item_modifier_groups / modifiers&lt;br&gt;&lt;br&gt;Asociar grupos con cardinalidad de selección.&lt;br&gt;Controla opciones obligatorias y límites." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="790" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-15" value="&lt;b&gt;MODIFICADOR&lt;/b&gt;&lt;br&gt;→ modifiers / modifier_item_impacts&lt;br&gt;&lt;br&gt;Precio e impacto de receta separados.&lt;br&gt;Cambios afectan consumo y disponibilidad." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="790" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-16" value="&lt;b&gt;ASIG_EXT_PLAT&lt;/b&gt;&lt;br&gt;→ menu_item_modifier_groups / modifiers&lt;br&gt;&lt;br&gt;Unificar extras con modificadores.&lt;br&gt;Evita dos mecanismos equivalentes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="980" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-17" value="&lt;b&gt;EXTRA&lt;/b&gt;&lt;br&gt;→ modifiers / modifier_item_impacts&lt;br&gt;&lt;br&gt;Representar extra como opción con cantidades.&lt;br&gt;Conserva costo, precio e impacto inventariable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="980" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-18" value="&lt;b&gt;ASIG_DISP_PLAT&lt;/b&gt;&lt;br&gt;→ menu_item_availability_overrides&lt;br&gt;&lt;br&gt;Reemplazar asociación estática por decisión temporal.&lt;br&gt;No sobrescribe decisiones humanas al recalcular." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="980" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-19" value="&lt;b&gt;DISPONIBILIDAD&lt;/b&gt;&lt;br&gt;→ menu_item_availability_overrides / service_status / inventory_allocations&lt;br&gt;&lt;br&gt;Calcular disponibilidad y conservar override.&lt;br&gt;No es un simple catálogo de etiquetas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="980" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-20" value="&lt;b&gt;MESAS&lt;/b&gt;&lt;br&gt;→ dining_tables / dining_table_status_history / reservation_table_assignments&lt;br&gt;&lt;br&gt;Agregar capacidad, zona y ocupación.&lt;br&gt;Reservar sin asignar mesa es válido." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="1170" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-21" value="&lt;b&gt;PEDIDO&lt;/b&gt;&lt;br&gt;→ orders&lt;br&gt;&lt;br&gt;Consolidar cabecera comercial.&lt;br&gt;Mesa y cliente opcionales según canal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="1170" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-22" value="&lt;b&gt;ORDEN&lt;/b&gt;&lt;br&gt;→ order_items / order_item_status_history&lt;br&gt;&lt;br&gt;Convertir detalle ambiguo en líneas explícitas.&lt;br&gt;Cantidad y cambios quedan por línea." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="1170" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-23" value="&lt;b&gt;ASIG_ORD_PLAT&lt;/b&gt;&lt;br&gt;→ order_items&lt;br&gt;&lt;br&gt;Eliminar puente sin atributos suficientes.&lt;br&gt;Cada línea referencia su platillo y precio histórico." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="1170" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-24" value="&lt;b&gt;PRIVILEGIO&lt;/b&gt;&lt;br&gt;→ permissions&lt;br&gt;&lt;br&gt;Conservar permisos atómicos.&lt;br&gt;Autorización por acción, no sólo administrador." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="1360" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-25" value="&lt;b&gt;ASIG_PRIV_ESTAT&lt;/b&gt;&lt;br&gt;→ role_permissions&lt;br&gt;&lt;br&gt;Reinterpretar asignación a rol.&lt;br&gt;Estado de cuenta no concede permisos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="1360" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-26" value="&lt;b&gt;ESTATUS&lt;/b&gt;&lt;br&gt;→ roles / users.status&lt;br&gt;&lt;br&gt;Separar rol de estado.&lt;br&gt;El preliminar usa estatus como agrupación de privilegios." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="1360" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-27" value="&lt;b&gt;USUARIO&lt;/b&gt;&lt;br&gt;→ users / user_credentials / customer_profiles / employee_profiles / user_roles&lt;br&gt;&lt;br&gt;Separar identidad, secreto, perfil y roles.&lt;br&gt;Eliminar contraseña corta y rol único." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="1360" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-28" value="&lt;b&gt;ASIG_PED_TIPED&lt;/b&gt;&lt;br&gt;→ orders.order_type&lt;br&gt;&lt;br&gt;Sustituir N:M por atributo obligatorio.&lt;br&gt;Un pedido tiene una modalidad de cumplimiento." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="1550" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-29" value="&lt;b&gt;TIPO_PED&lt;/b&gt;&lt;br&gt;→ orders.order_type&lt;br&gt;&lt;br&gt;Dominio controlado DINE_IN/PICKUP/DELIVERY.&lt;br&gt;No confundir modalidad con canal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="1550" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-30" value="&lt;b&gt;ASIG_ESTPED_PED&lt;/b&gt;&lt;br&gt;→ order_status_history / orders.status&lt;br&gt;&lt;br&gt;Separar historial y estado actual.&lt;br&gt;Una asociación sin fecha no representa transiciones." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="1550" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-31" value="&lt;b&gt;ESTADO_PEDIDO&lt;/b&gt;&lt;br&gt;→ orders.status / order_status_history / orders.estimated_ready_at&lt;br&gt;&lt;br&gt;Estado controlado y ETA por pedido.&lt;br&gt;El tiempo aproximado depende del pedido y carga." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="1550" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-32" value="&lt;b&gt;CUENTA&lt;/b&gt;&lt;br&gt;→ bills / bill_orders / bill_items / tips&lt;br&gt;&lt;br&gt;Desacoplar cuenta, mesa y propina.&lt;br&gt;Permite división por cantidad y reunión de pedidos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="1740" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-33" value="&lt;b&gt;ASIG_ESTCUE_CUENTA&lt;/b&gt;&lt;br&gt;→ bills.status / audit_logs&lt;br&gt;&lt;br&gt;Estado vigente más auditoría de cambio.&lt;br&gt;No mantener estados simultáneos contradictorios." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="1740" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-34" value="&lt;b&gt;EST_CUENT&lt;/b&gt;&lt;br&gt;→ bills.status&lt;br&gt;&lt;br&gt;Dominio OPEN/ISSUED/PAID/VOID.&lt;br&gt;Transiciones protegidas en transacción." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="1740" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-35" value="&lt;b&gt;TOT_MET_PAG&lt;/b&gt;&lt;br&gt;→ payments / payment_allocations / payment_refunds&lt;br&gt;&lt;br&gt;Registrar cobros individuales y reversos.&lt;br&gt;Un total por método pierde intentos y pagos parciales." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1490" y="1740" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-36" value="&lt;b&gt;MET_PAG&lt;/b&gt;&lt;br&gt;→ payment_methods&lt;br&gt;&lt;br&gt;Catálogo configurable.&lt;br&gt;Identifica efectivo sin acoplar nombre de método." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="1930" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-37" value="&lt;b&gt;CAJA&lt;/b&gt;&lt;br&gt;→ cash_registers / cash_sessions / cash_movements / cash_reconciliations&lt;br&gt;&lt;br&gt;Eliminar ciclo caja-total pagado-cuenta.&lt;br&gt;Libro de caja, responsables y arqueos independientes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="510" y="1930" width="450" height="165" />
        </mxCell>
        <mxCell id="legacy-38" value="&lt;b&gt;FACTURA&lt;/b&gt;&lt;br&gt;→ invoices / invoice_items&lt;br&gt;&lt;br&gt;Preservar datos fiscales e importes históricos.&lt;br&gt;NIT opcional, emisión/anulación explícitas y notas de crédito." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17212e;strokeColor=#65758b;fontColor=#e6edf3;align=left;verticalAlign=top;spacing=10;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1000" y="1930" width="450" height="165" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

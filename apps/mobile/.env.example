# Public mobile BFF URL; use a LAN-reachable host or local DNS name for a phone.
# Local BFF: 8082. Core API: 8080. Expo Metro: 8081. Use HTTPS outside local development.
# Browser on this computer: http://127.0.0.1:8082. A phone cannot reach a loopback-only BFF.
# Existing local BFF CORS allows browser origin http://localhost:8081, not http://127.0.0.1:8081.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8082

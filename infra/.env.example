# Copy to the repository root as .env, which is ignored by Git.
# Generate independent random values; never use these comments as secrets.
WOK_DB_NAME=wok
WOK_DB_USER=wok_app
WOK_DB_PASSWORD=
WOK_AUTH_JWT_SECRET_BASE64=
WOK_AUTH_CHALLENGE_PEPPER_BASE64=
WOK_HTTP_BIND_ADDRESS=0.0.0.0
WOK_HTTP_PORT=80
WOK_AI_MODE=disabled
WOK_EMAIL_MODE=mock
# Enable only when a real SMTP provider is configured and should affect health.
WOK_EMAIL_HEALTH_ENABLED=false
# Optional production SMTP; omit host to keep email adapter non-delivering.
WOK_SMTP_HOST=
WOK_SMTP_PORT=587
WOK_SMTP_USERNAME=
WOK_SMTP_PASSWORD=
# TLS deployment also requires WOK_TLS_CERT_PATH and WOK_TLS_KEY_PATH.
